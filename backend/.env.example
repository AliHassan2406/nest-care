# Copy this file to .env and change JWT_SECRET before any non-demo use.
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Public API gateway port
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Internal services (bound to 127.0.0.1)
AUTH_SERVICE_PORT=4001
REQUESTS_SERVICE_PORT=4002
CATALOG_SERVICE_PORT=4003
NOTIFICATIONS_SERVICE_PORT=4004

# Service-to-service URL used for request notifications
NOTIFICATION_SERVICE_URL=http://127.0.0.1:4004

# Shared SQLite database path (defaults to backend/data/nestcare.sqlite)
# NESTCARE_DB_PATH=backend/data/nestcare.sqlite
